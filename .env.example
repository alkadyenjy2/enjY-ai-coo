# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL for real Supabase database connection.
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY: Publishable or Anon Key for real Supabase connection.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# PHASE 7 LIVE CONNECTORS & SERVICE SECRETS
POSTIZ_API_KEY=
POSTIZ_API_URL=https://api.postiz.com/v1

WHOP_API_KEY=

OUTSCRAPER_API_KEY=

GHL_API_KEY=
GHL_LOCATION_ID=

TAVILY_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CLINIC AUTOMATION PORTFOLIO DEMO
# Optional. When set, the "Run Live Make Demo" button proxies the demo lead to
# the real Make webhook from the server side and reports the REAL HTTP outcome.
# When unset, the button reports "not_configured" instead of faking success.
MAKE_CLINIC_WEBHOOK_URL=

# GMAIL API / OAuth2
# Never commit real values. Store them in local/Vercel secrets.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional; defaults to the local OAuth callback used by scripts/gmail-oauth.ts.
GMAIL_REDIRECT_URI=http://localhost:53682/oauth2callback
# Live test is opt-in and requires GMAIL_TEST_TO.
GMAIL_LIVE_TEST=false
GMAIL_TEST_TO=
# TELEGRAM BOT / WEBHOOK
# Store real values only in deployment secrets; never commit tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
