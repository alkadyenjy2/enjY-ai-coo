# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL for real Supabase database connection.
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_ANON_KEY: Publishable or Anon Key for real Supabase connection.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# PHASE 7 LIVE CONNECTORS & SERVICE SECRETS
POSTIZ_API_KEY=
POSTIZ_API_URL=https://api.postiz.com/v1

WHOP_API_KEY=

OUTSCRAPER_API_KEY=

GHL_API_KEY=
GHL_LOCATION_ID=

TAVILY_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
